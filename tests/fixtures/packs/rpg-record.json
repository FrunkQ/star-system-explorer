{
 "format": "sse.pack/1",
 "id": "test.rpg-record",
 "version": "0.1.0",
 "kind": [
  "game-system"
 ],
 "kernel_range": "^0.1",
 "licence": "Apache-2.0",
 "provides": {
  "other": {
   "observe": {
    "disclosure": {
     "fields": {
      "name": "obvious",
      "kind": "obvious",
      "size_class": "obvious",
      "colour": "obvious",
      "spectral": "obvious",
      "orbit.*": "scanned",
      "mass_kg": "scanned",
      "atmosphere.*": "scanned",
      "surface.*": "scanned",
      "ocean.*": "scanned",
      "hazards": "scanned",
      "luminosity_w": "scanned",
      "interior.*": "surveyed",
      "resources": "surveyed",
      "settlements.*": "surveyed",
      "gm.*": "secret",
      "story.*": "secret"
     },
     "tags": {
      "habitable": "scanned",
      "port": "scanned",
      "hazard": "scanned",
      "garden": "scanned",
      "ancient-ruins": "secret"
     }
    },
    "views": [
     {
      "id": "long-range",
      "label": "Long-range sensors",
      "description": "Exists, rough size and colour",
      "show_tiers": [
       "obvious"
      ],
      "tags": {
       "mode": "none"
      },
      "unknown_style": "placeholder",
      "overrides": [
       {
        "target": {
         "kind": "field",
         "id": "trade.credits"
        },
        "show": true,
        "precision": {
         "as": "band",
         "step": 1000,
         "half_width": 500
        }
       }
      ]
     },
     {
      "id": "scanned",
      "label": "Scanned",
      "description": "Orbit, mass, air, temperature, hazards",
      "show_tiers": [
       "obvious",
       "scanned"
      ],
      "tags": {
       "mode": "listed",
       "list": [
        "hazard",
        "habitable",
        "port"
       ]
      },
      "overrides": [
       {
        "target": {
         "kind": "field",
         "id": "surface.temp_mean_k"
        },
        "show": true,
        "precision": {
         "as": "band",
         "step": 10,
         "half_width": 10
        }
       }
      ],
      "unknown_style": "placeholder"
     },
     {
      "id": "survey",
      "label": "Survey on file",
      "description": "Adds interiors, resources, settlements",
      "show_tiers": [
       "obvious",
       "scanned",
       "surveyed"
      ],
      "tags": {
       "mode": "all"
      },
      "unknown_style": "placeholder"
     },
     {
      "id": "rumour",
      "label": "Rumour only",
      "description": "Name and one story line, no numbers",
      "show_tiers": [],
      "tags": {
       "mode": "none"
      },
      "overrides": [
       {
        "target": {
         "kind": "field",
         "id": "name"
        },
        "show": true
       },
       {
        "target": {
         "kind": "field",
         "id": "story.rumour"
        },
        "show": true
       }
      ],
      "unknown_style": "omit"
     }
    ],
    "campaign": {
     "default_view": "long-range",
     "before": "long-range",
     "after": "scanned"
    }
   },
   "record": {
    "kept": [
     {
      "id": "trade.credits",
      "shape": "number",
      "unit": "Cr",
      "default": 0,
      "tier": "scanned",
      "writers": [
       "gm",
       "intent.trade"
      ],
      "describes": "the party's purse (players at long range see it only as a band)"
     },
     {
      "id": "politics.standing",
      "shape": "number",
      "range": [
       -10.0,
       10.0
      ],
      "default": 0,
      "tier": "secret",
      "writers": [
       "gm",
       "effect.consequence"
      ],
      "describes": "how an actor regards the party"
     },
     {
      "id": "politics.allegiance",
      "shape": "ref",
      "tier": "scanned",
      "writers": [
       "gm"
      ],
      "describes": "whom an actor or place answers to"
     }
    ]
   },
   "tags": {
    "about": "Tags this pack names (tags design, TG1): labels only, never an input to physics.",
    "groups": [],
    "tags": [
     {
      "id": "habitable",
      "label": "habitable"
     },
     {
      "id": "port",
      "label": "port"
     },
     {
      "id": "hazard",
      "label": "hazard"
     },
     {
      "id": "garden",
      "label": "garden"
     },
     {
      "id": "ancient-ruins",
      "label": "ancient ruins"
     }
    ]
   }
  }
 }
}
