{
  "schema": "sse.sifters/0",
  "note": "Starter sifters for the story finder (U8): plain data, meant to be edited and added to (by the GM or Orac). Each is a pattern over facts or events and how much a hit matters: how long it lasts, how far it reaches, how hard it is to undo, and how rare it is under its parent's cloud.",
  "sifters": [
    { "id": "story.star-turns", "label": "A star changing, and its worlds with it",
      "pattern": { "match": "event", "kind": "evolve.transition", "field": "star.phase" },
      "significance": { "persistence": { "from": "fixed", "yr": 1e6 }, "reach": { "from": "descendants" }, "reversibility": 0 } },
    { "id": "story.danger-at-home", "label": "Danger where people live", "applies_to": ["body"],
      "pattern": { "match": "facts", "when": { "if": "all", "of": [ { "if": "has", "field": "hazards" }, { "if": "range", "field": "settlements.count", "min": 1 } ] } },
      "significance": { "persistence": { "from": "fixed", "yr": 100 }, "reach": { "from": "fixed", "n": 1000 }, "reversibility": 0.3 } },
    { "id": "story.ruins", "label": "Ruins of someone who came before", "applies_to": ["body"],
      "pattern": { "match": "facts", "when": { "if": "tag", "tag": "ancient-ruins" } },
      "significance": { "persistence": { "from": "fixed", "yr": 1e6 }, "reach": { "from": "fixed", "n": 10 }, "reversibility": 0.05 } },
    { "id": "story.secret", "label": "A secret the GM wrote down", "applies_to": ["body"],
      "pattern": { "match": "facts", "when": { "if": "has", "field": "gm.notes" } },
      "significance": { "persistence": { "from": "fixed", "yr": 10 }, "reach": { "from": "fixed", "n": 3 }, "reversibility": 0.4 } },
    { "id": "story.rumour", "label": "A rumour to chase",
      "pattern": { "match": "facts", "when": { "if": "has", "field": "story.rumour" } },
      "significance": { "persistence": { "from": "fixed", "yr": 1 }, "reach": { "from": "fixed", "n": 3 }, "reversibility": 0.6 } },
    { "id": "story.garden", "label": "A garden world", "applies_to": ["body"],
      "pattern": { "match": "facts", "when": { "if": "tag", "tag": "garden" } },
      "significance": { "persistence": { "from": "fixed", "yr": 1e9 }, "reach": { "from": "descendants" }, "reversibility": 0.1 } },
    { "id": "story.riches", "label": "Something worth taking", "applies_to": ["body"],
      "pattern": { "match": "facts", "when": { "if": "has", "field": "resources" } },
      "significance": { "persistence": { "from": "fixed", "yr": 100 }, "reach": { "from": "fixed", "n": 100 }, "reversibility": 0.5 } },
    { "id": "story.ending", "label": "Something ending within a century",
      "pattern": { "match": "facts", "when": { "if": "within", "field": "life.ends_s", "from_s": 0, "to_s": 3155760000 } },
      "significance": { "persistence": { "from": "life-remaining" }, "reach": { "from": "descendants" }, "reversibility": 0.0 } }
  ]
}
