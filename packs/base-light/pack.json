    ],
    "grid": { "from_m": 1e-14, "to_m": 1e4, "points": 145 },
    "steps_per_decade": 64,
    "disc_rings": 48,
    "references": [
     { "text": "NIST Atomic Spectra Database (Kramida, A., Ralchenko, Yu., Reader, J. and NIST ASD Team), rest wavelengths of atomic lines", "url": "https://physics.nist.gov/asd" },
     { "text": "Osterbrock, D. E. and Ferland, G. J. 2006, Astrophysics of Gaseous Nebulae and Active Galactic Nuclei, 2nd edn, University Science Books: the nebular line list (H I, [O II], [O III], [N II], [S II], He I, He II)", "url": "https://uscibooks.aip.org/books/astrophysics-of-gaseous-nebulae-and-active-galactic-nuclei-second-edition/" },
     { "text": "Splatalogue spectral line catalogue: CO J=1-0 at 115.2712018 GHz and the H I hyperfine line at 1420.405751768 MHz", "url": "https://splatalogue.online/" }
    ]
   }
  }
 }
}
