    "flows": [
      {
        "format": "sse.flow/1",
        "id": "sse.base-light.body-emission",
        "version": "0.1.0",
        "hook": "body.emission",
        "inputs": [
          {
            "name": "flux",
            "kind": "planet.insolation"
          },
          {
            "name": "albedo",
            "kind": "planet.bond_albedo"
          },
          {
            "name": "internal_flux",
            "kind": "body.internal_heat_flux"
          },
          {
            "name": "radius",
            "kind": "body.radius"
          },
          {
            "name": "moment",
            "kind": "body.magnetic_moment"
          },
          {
            "name": "distance",
            "kind": "orbit.semi_major_axis"
          }
        ],
        "nodes": [
          {
            "id": "glow",
            "atom": "sse.light.effective_temperature"
          },
          {
            "id": "wind",
            "atom": "sse.light.stellar_wind"
          },
          {
            "id": "bubble",
            "atom": "sse.light.magnetopause_radius"
          },
          {
            "id": "radio",
            "atom": "sse.light.auroral_radio_power"
          },
          {
            "id": "top",
            "atom": "sse.light.cyclotron_frequency"
          }
        ],
        "wires": [
          {
            "from": "in.flux",
            "to": "glow.flux"
          },
          {
            "from": "in.albedo",
            "to": "glow.albedo"
          },
          {
            "from": "in.internal_flux",
            "to": "glow.internal_flux"
          },
          {
            "from": "in.distance",
            "to": "wind.distance"
          },
          {
            "from": "in.moment",
            "to": "bubble.moment"
          },
          {
            "from": "wind.density",
            "to": "bubble.density"
          },
          {
            "from": "wind.speed",
            "to": "bubble.speed"
          },
          {
            "from": "wind.field",
            "to": "radio.field"
          },
          {
            "from": "wind.speed",
            "to": "radio.speed"
          },
          {
            "from": "bubble.radius",
            "to": "radio.magnetopause"
          },
          {
            "from": "in.radius",
            "to": "radio.radius"
          },
          {
            "from": "in.moment",
            "to": "top.moment"
          },
          {
            "from": "in.radius",
            "to": "top.radius"
          }
        ],
        "publishes": [
          {
            "kind": "body.effective_temperature",
            "from": "glow.teff"
          },
          {
            "kind": "body.magnetopause_radius",
            "from": "bubble.radius"
          },
          {
            "kind": "radio.auroral_power",
            "from": "radio.power"
          },
          {
            "kind": "radio.max_frequency",
            "from": "top.frequency"
          }
        ],
        "tests": [
          {
            "name": "Earth (NSSDC fact sheet: Bond albedo 0.294, black-body temperature 254.0 K; magnetopause about 10 Earth radii, Kivelson and Russell 1995)",
            "inputs": {
              "flux": {
                "value": 1361.0,
                "unit": "w_m2"
              },
              "albedo": {
                "value": 0.294,
                "unit": "one"
              },
              "internal_flux": {
                "value": 0.09,
                "unit": "w_m2"
              },
              "radius": {
                "value": 6378.137,
                "unit": "km"
              },
              "moment": {
                "value": 7.94e+22,
                "unit": "a_m2"
              },
              "distance": {
                "value": 1.0,
                "unit": "au"
              }
            },
            "expect": {
              "body.effective_temperature": {
                "value": 254.0,
                "unit": "k",
                "tol": 1.0
              },
              "body.magnetopause_radius": {
                "value": 10.0,
                "unit": "r_earth",
                "tol": 1.5
              }
            }
          },
          {
            "name": "Jupiter (Li et al. 2018: Bond albedo 0.503, internal heat 7.485 W/m², effective temperature 125.57 K)",
            "inputs": {
              "flux": {
                "value": 50.26,
                "unit": "w_m2"
              },
              "albedo": {
                "value": 0.503,
                "unit": "one"
              },
              "internal_flux": {
                "value": 7.485,
                "unit": "w_m2"
              },
              "radius": {
                "value": 71492.0,
                "unit": "km"
              },
              "moment": {
                "value": 1.571e+27,
                "unit": "a_m2"
              },
              "distance": {
                "value": 5.2026,
                "unit": "au"
              }
            },
            "expect": {
              "body.effective_temperature": {
                "value": 125.57,
                "unit": "k",
                "tol": 1.5
              }
            }
          },
          {
            "name": "Neptune (Pearl and Conrath 1991: Bond albedo 0.290, internal heat 0.433 W/m², effective temperature 59.3 ± 0.8 K)",
            "inputs": {
              "flux": {
                "value": 1.51,
                "unit": "w_m2"
              },
              "albedo": {
                "value": 0.29,
                "unit": "one"
              },
              "internal_flux": {
                "value": 0.433,
                "unit": "w_m2"
              },
              "radius": {
                "value": 24764.0,
                "unit": "km"
              },
              "moment": {
                "value": 2.16e+24,
                "unit": "a_m2"
              },
              "distance": {
                "value": 30.07,
                "unit": "au"
              }
            },
            "expect": {
              "body.effective_temperature": {
                "value": 59.3,
                "unit": "k",
                "tol": 0.8
              }
            }
          },
          {
            "name": "Mars (NSSDC: Bond albedo 0.250, black-body 209.8 K; no global field, so no magnetosphere and no auroral radio)",
            "inputs": {
              "flux": {
                "value": 586.2,
                "unit": "w_m2"
              },
              "albedo": {
                "value": 0.25,
                "unit": "one"
              },
              "internal_flux": {
                "value": 0.0,
                "unit": "w_m2"
              },
              "radius": {
                "value": 3396.2,
                "unit": "km"
              },
              "moment": {
                "value": 0.0,
                "unit": "a_m2"
              },
              "distance": {
                "value": 1.52368,
                "unit": "au"
              }
            },
            "expect": {
              "body.effective_temperature": {
                "value": 209.8,
                "unit": "k",
                "tol": 1.0
              },
              "radio.auroral_power": {
                "value": 0.0,
                "unit": "w",
                "tol": 0.0
