    "flows": [
      {
        "format": "sse.flow/1",
        "id": "sse.base-light.body-emission",
        "version": "0.1.0",
        "hook": "body.emission",
        "inputs": [
          {
            "name": "flux",
            "kind": "planet.insolation"
          },
          {
            "name": "albedo",
            "kind": "planet.bond_albedo"
          },
          {
            "name": "internal_flux",
            "kind": "body.internal_heat_flux"
          },
          {
            "name": "radius",
            "kind": "body.radius"
          },
          {
            "name": "moment",
            "kind": "body.magnetic_moment"
          },
          {
            "name": "distance",
            "kind": "orbit.semi_major_axis"
          }
        ],
        "nodes": [
          {
            "id": "glow",
            "atom": "sse.light.effective_temperature"
          },
          {
            "id": "wind",
            "atom": "sse.light.stellar_wind"
          },
          {
            "id": "bubble",
            "atom": "sse.light.magnetopause_radius"
          },
          {
            "id": "radio",
            "atom": "sse.light.auroral_radio_power"
          },
          {
            "id": "top",
            "atom": "sse.light.cyclotron_frequency"
          }
        ],
        "wires": [
          {
            "from": "in.flux",
            "to": "glow.flux"
          },
          {
            "from": "in.albedo",
            "to": "glow.albedo"
          },
          {
            "from": "in.internal_flux",
            "to": "glow.internal_flux"
          },
          {
            "from": "in.distance",
            "to": "wind.distance"
          },
          {
            "from": "in.moment",
            "to": "bubble.moment"
          },
          {
            "from": "wind.density",
            "to": "bubble.density"
          },
          {
            "from": "wind.speed",
            "to": "bubble.speed"
          },
          {
            "from": "wind.field",
            "to": "radio.field"
          },
          {
            "from": "wind.speed",
            "to": "radio.speed"
          },
          {
            "from": "bubble.radius",
            "to": "radio.magnetopause"
          },
          {
            "from": "in.radius",
            "to": "radio.radius"
          },
          {
            "from": "in.moment",
            "to": "top.moment"
          },
          {
            "from": "in.radius",
            "to": "top.radius"
          }
        ],
        "publishes": [
          {
            "kind": "body.effective_temperature",
            "from": "glow.teff"
          },
          {
            "kind": "body.magnetopause_radius",
            "from": "bubble.radius"
          },
          {
            "kind": "radio.auroral_power",
            "from": "radio.power"
          },
          {
            "kind": "radio.max_frequency",
            "from": "top.frequency"
          }
        ],
        "tests": [
          {
            "name": "Earth (NSSDC fact sheet: Bond albedo 0.294, solar irradiance 1361 W/m²; effective temperature 255 K from the measured outgoing longwave of 239.7 W/m², Loeb et al. 2018, doi:10.1175/JCLI-D-17-0208.1; the fact sheet's 254.0 K black-body figure belongs to its older albedo 0.306 and does not follow from its own 0.294; magnetopause about 10 Earth radii, Kivelson and Russell 1995)",
            "inputs": {
              "flux": {
                "value": 1361.0,
                "unit": "w_m2"
              },
              "albedo": {
                "value": 0.294,
                "unit": "one"
              },
              "internal_flux": {
                "value": 0.09,
                "unit": "w_m2"
              },
              "radius": {
                "value": 6378.137,
                "unit": "km"
              },
              "moment": {
                "value": 7.94e+22,
                "unit": "a_m2"
              },
              "distance": {
                "value": 1.0,
                "unit": "au"
              }
            },
            "expect": {
              "body.effective_temperature": {
                "value": 255.0,
                "unit": "k",
                "tol": 1.0
              },
              "body.magnetopause_radius": {
                "value": 10.0,
                "unit": "r_earth",
                "tol": 1.5
              }
            }
          },
          {
