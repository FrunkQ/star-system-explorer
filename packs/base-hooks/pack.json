            "max": 5.972167867791379e+25
           },
           {
            "if": "range",
            "field": "mass_earth",
            "max": 10.0
           }
          ]
         }
        ]
       },
       {
        "if": "any",
        "of": [
         {
          "if": "range",
          "field": "planet.surface_temperature",
          "max": 150.0
         },
         {
          "if": "range",
          "field": "surface_k",
          "max": 150.0
         }
        ]
       }
      ]
     }
    },
    {
     "id": "access.water.v1",
     "tag": "access.water",
     "applies_to": [
      "body"
     ],
     "when": {
      "if": "all",
      "of": [
       {
        "if": "all",
