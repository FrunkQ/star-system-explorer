{
  "format": "sse.pack/1",
  "id": "sse.base-ships",
  "version": "0.2.0",
  "kind": [
    "base-physics"
  ],
  "kernel_range": "^0.1",
  "licence": "Apache-2.0",
  "provides": {
    "other": {
      "about": "Ship designer (V3 gap item 14, stage 2): the rules that size a ship's parts from what they must do, and the styles that arrange them. A style decides the arrangement and the look, never a size. Numbers marked authored or rough are rules for play and pictures, listed in the fudge register; the drive's own numbers come from the ship record.",
      "ship_design": {
        "crew": {
          "habitable_m3_per_person": 25.0,
          "net_to_gross": 0.5,
          "why": "net habitable volume per person for missions of months; a pressurised module is about twice its net habitable volume once equipment and stowage are in",
          "src": "nasa-std-3001",
          "check": "unverified"
        },
        "cargo": {
          "stowage_kg_m3": 250.0,
          "why": "mixed packed cargo; authored",
          "src": "authored"
        },
        "radiator": {
          "emissivity": 0.9,
          "two_sided": true,
          "why": "a flat panel radiates from both faces at emissivity 0.9; area = waste heat / (2 e sigma T^4)",
          "src": "authored"
        },
        "drive_heat": [
          {
            "fuels": [
              "hydrogen-oxygen"
            ],
            "waste_per_jet": 0.0,
            "radiator_k": 0.0,
            "why": "combustion heat leaves with the exhaust; the nozzle is cooled by its own propellant",
            "src": "authored"
          },
          {
            "fuels": [
              "hydrogen"
            ],
            "waste_per_jet": 0.0,
            "radiator_k": 0.0,
            "why": "a nuclear thermal reactor is cooled by the propellant it heats while it burns",
            "src": "authored"
          },
          {
            "fuels": [
              "deuterium",
              "helium-3"
            ],
            "waste_per_jet": 0.1,
            "radiator_k": 1500.0,
            "why": "rough: neutrons from side reactions and bremsstrahlung heat the structure and must be radiated; about a tenth of the jet power",
            "src": "santarius-logan-1998",
            "check": "unverified"
          },
          {
            "fuels": [
              "antimatter"
            ],
            "waste_per_jet": 0.1,
            "radiator_k": 1500.0,
            "why": "rough: gamma rays caught by the engine's shielding heat it; about a tenth of the jet power",
            "src": "authored"
          }
        ],
        "sources": {
          "nasa-std-3001": "NASA 2015, NASA Space Flight Human-System Standard, NASA-STD-3001 Volume 2 Revision A, habitable volume section. https://www.nasa.gov/reference/nasa-std-3001/",
          "santarius-logan-1998": "Santarius, J. F. and Logan, B. G. 1998, Generic magnetic fusion rocket model, Journal of Propulsion and Power 14, 519. doi:10.2514/2.5309",
          "authored": "authored for play and pictures; in the fudge register",
          "nasa-shuttle-tps": "NASA, Space Shuttle Orbiter thermal protection system (tiles and reinforced carbon-carbon); reference to be checked. https://ntrs.nasa.gov/",
          "tran-1997": "Tran, H. K. et al. 1997, Qualification of the forebody heatshield of the Stardust's Sample Return Capsule, AIAA paper 97-2482.",
          "hoerner-1965": "Hoerner, S. F. 1965, Fluid-Dynamic Drag, Hoerner Fluid Dynamics.",
          "nasa-shuttle-aero": "Iliff, K. W. and Shafer, M. F., Space Shuttle hypersonic aerodynamic and aerothermodynamic flight research, NASA technical memorandum; reference to be checked. https://ntrs.nasa.gov/",
          "nasa-lifting-bodies": "Reed, R. D. and Lister, D. 1997, Wingless Flight: The Lifting Body Story, NASA SP-4220.",
          "nasa-lm-gear": "Rogers, W. F. 1972, Apollo experience report: lunar module landing gear subsystem, NASA TN D-6850.",
          "cruz-2014": "Cruz, J. R. et al. 2014, Reconstruction of the Mars Science Laboratory parachute performance, Journal of Spacecraft and Rockets 51, 1185.",
          "milos-1997": "Milos, F. S. 1997, Galileo probe heat shield ablation experiment, Journal of Spacecraft and Rockets 34, 705."
        },
        "abilities": {
          "about": "Stage 4: what a ship must do sizes the parts that let it. The kernel's ship_at_world judges each pass; the designer scales a part by the law its figure follows until the figure sits at `margin` of its limit, then asks again.",
          "margin": 0.75,
          "margin_why": "the same mark the kernel uses for its own 'would pass' advice",
          "shields": [
            {
              "kind": "reusable",
              "name": "tiled",
              "max_heat_flux_w_m2": 500000.0,
              "areal_kg_m2": 15.0,
              "why": "silica tiles and carbon-carbon leading edges, as on the Space Shuttle; rough limit from radiative equilibrium near 1,600 K",
              "src": "nasa-shuttle-tps",
              "check": "unverified"
            },
            {
              "kind": "ablative",
              "name": "PICA",
              "max_heat_flux_w_m2": 12000000.0,
              "heat_of_ablation_j_kg": 50000000.0,
              "min_areal_kg_m2": 10.0,
              "why": "phenolic-impregnated carbon ablator; Stardust came back at about 1.2 kW/cm²",
              "src": "tran-1997",
              "check": "unverified"
            },
            {
              "kind": "ablative",
              "name": "carbon phenolic",
              "max_heat_flux_w_m2": 300000000.0,
              "heat_of_ablation_j_kg": 30000000.0,
              "min_areal_kg_m2": 30.0,
              "why": "the dense ablator of the Galileo probe, which entered Jupiter at about 30 kW/cm²",
              "src": "milos-1997",
              "check": "unverified"
            }
          ],
          "nose_over_base": 2.4,
          "nose_over_base_why": "Apollo's command module: a 4.7 m spherical nose radius on a 1.96 m base radius",
          "shield_base_max_r": 3.0,
          "shield_base_max_why": "authored: wider than three hull radii a shield would have to be inflatable or deploy, which the designer does not draw",
          "cd": {
            "shield": 1.4,
            "open": 1.2,
            "skin": 0.5,
            "why": "rough hypersonic and subsonic drag coefficients: a blunt capsule face about 1.3 to 1.5, an open truss with modules about 1.2, a pointed skin about 0.5",
            "src": "hoerner-1965",
            "check": "unverified"
          },
          "wing": {
            "cl_max": 1.0,
            "aspect": 2.3,
            "sweep_deg": 45.0,
            "l_over_d": 1.0,
            "max_span_over_length": 1.5,
            "why": "a delta like the Space Shuttle's: aspect about 2.3, landing lift coefficient about 1, lift over drag about 1 on entry; wings longer than one and a half hulls are not drawn (authored)",
            "src": "nasa-shuttle-aero",
            "check": "unverified"
          },
          "lifting_body": {
            "cl_max": 0.6,
            "l_over_d": 1.0,
            "why": "a hull shaped to lift on its own, like the X-24 and HL-10 test craft: less lift per area than a wing",
            "src": "nasa-lifting-bodies",
            "check": "unverified"
          },
          "legs": {
            "max_touchdown_m_s": 3.0,
            "why": "the Apollo lunar module's legs took about 3 m/s straight down (10 ft/s)",
            "src": "nasa-lm-gear",
            "check": "unverified"
          },
          "chute": {
            "cd": 0.6,
            "max_mach": 2.2,
            "max_q_pa": 850.0,
            "fill_s": 1.0,
            "max_area_over_front": 30.0,
            "why": "a disk-gap-band supersonic parachute as on Mars landers: drag coefficient about 0.6, opened below Mach 2.2 and 850 Pa; a canopy more than 30 times the ship's frontal area is not carried (authored; Curiosity's was about 23 times)",
            "src": "cruz-2014",
            "check": "unverified"
          },
          "scoop": {
            "skim_density_kg_m3": 1e-05,
            "skim_speed_m_s": 50000.0,
            "fill_days": 1.0,
            "why": "authored: an intake that fills the tanks in a day of skimming passes through a giant's thin upper air at orbital speed; area = propellant / (density x speed x time)",
            "src": "authored"
          },
          "shield_emissivity": 0.85,
          "shield_emissivity_why": "a charred ablator or a tiled face radiates at about 0.85; the pass view shows the face at radiative balance with the peak heating"
        }
      },
