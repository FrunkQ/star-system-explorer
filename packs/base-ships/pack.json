      "station_design": {
        "about": "Station and land construct builder (renderer station-design.ts): a construct's description picks a shape, its population sizes it, and its gravity, power and traffic size the parts. A shape decides the arrangement only, never a size. The megastructure line is read off the physics: the strength a spun hull needs against the materials on base-tech's strength_for_weight ladder, the height a tower can stand, and whether its own gravity holds a walker.",
        "living": [
          {
            "id": "post",
            "m3_per_person": 50.0,
            "why": "a working post: the ship rule, 25 m3 of net habitable volume per person over a net to gross of 0.5",
            "src": "nasa-std-3001",
            "check": "unverified"
          },
          {
            "id": "home",
            "m3_per_person": 6900.0,
            "why": "a settlement people live their lives in: the Stanford torus's volume over its 10,000 people (a tube 130 m across round a 830 m radius)",
            "src": "johnson-holbrow-1977"
          }
        ],
        "spin": {
          "g_default": 1.0,
          "why": "spun to one standard gravity unless the record or the GM says otherwise; the spin rate is capped by base-tech's spin_rpm (comfort)",
          "src": "globus-hall2017"
        },
        "hoop": {
          "safety": 2.0,
          "load_over_shell": 1.0,
          "why": "a spun ring's hull carries its own weight (stress over density = g R) and as much again of air, soil and shielding, with a safety factor of 2",
          "src": "authored"
        },
        "tower": {
          "safety": 2.0,
          "why": "a tower of one material stands to its strength over density over g; a safety factor of 2",
          "src": "authored"
        },
        "self_gravity": {
          "escape_m_s": 1.0,
          "why": "when a walker can no longer jump off it, its own gravity matters: it is a body, not a building",
          "src": "authored"
        },
        "mass_kg_per_m3": {
          "v": 150.0,
          "why": "structure, air and shielding over enclosed volume, about the Stanford torus's",
          "src": "johnson-holbrow-1977",
          "check": "unverified"
        },
        "power": {
          "w_per_person": 10000.0,
          "efficiency": 0.3,
          "radiator_k": 300.0,
          "why": "about 10 kW a head for life support, industry and light; solar panels at 30%; waste heat radiated at room temperature from both faces",
          "src": "authored"
        },
        "urban_density_per_km2": {
          "v": 4000.0,
          "why": "a town on the ground spreads at about the density of a European city",
          "src": "authored"
        },
        "docks": {
          "people_per_berth": 500.0,
          "size_share": 0.5,
          "port_bonus": 2.0,
          "classes": [
            {
              "id": "small",
              "name": "small craft",
              "max_ship_m": 50.0
            },
            {
              "id": "ship",
              "name": "ships",
              "max_ship_m": 200.0
            },
            {
              "id": "large",
              "name": "large ships",
              "max_ship_m": 1000.0
            },
            {
              "id": "capital",
              "name": "capital ships",
              "max_ship_m": 5000.0
            }
          ],
          "why": "a berth for every 500 people, doubled at a port; a berth takes ships up to half the station's size; each class up has half as many berths",
          "src": "authored"
        },
        "bolt_on_share": 0.02,
        "sources": {
          "johnson-holbrow-1977": "Johnson, R. D. and Holbrow, C. (eds) 1977, Space Settlements: A Design Study, NASA SP-413. https://ntrs.nasa.gov/citations/19770014162",
          "globus-hall2017": "Globus, A. and Hall, T. 2017, Space settlement population rotation tolerance, NSS Space Settlement Journal 2.",
          "nasa-std-3001": "NASA 2015, NASA Space Flight Human-System Standard, NASA-STD-3001 Volume 2 Revision A. https://www.nasa.gov/reference/nasa-std-3001/",
          "authored": "authored for play and pictures; in the fudge register"
        }
