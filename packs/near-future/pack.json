    {
     "id": "nf.label.homeworld.v1",
     "tag": "nf.label.homeworld",
     "applies_to": [
      "body"
     ],
     "when": {
      "if": "all",
      "of": [
       {
        "if": "all",
        "of": [
         {
          "if": "all",
          "of": [
           {
            "if": "not",
            "p": {
             "if": "has",
             "field": "star.effective_temperature"
            }
           },
