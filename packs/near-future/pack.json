   "dressing": {
    "about": "Near future: which worlds get a port, a base or a faction's presence, and why.",
    "rules": [
     {
      "id": "nf.yard.v1",
      "applies_to": [
       "body"
      ],
      "when": {
       "if": "tag",
       "tag": "nf.label.homeworld"
      },
      "place": "nf_orbital_yard",
      "where": "high-orbit",
      "tags": [
       "nf.faction.accord"
      ],
      "faction": "nf.faction.accord",
      "explain": "a home-type world has an Accord orbital yard above it: the port where inner-system traffic docks"
     },
     {
      "id": "nf.patrol.v1",
      "applies_to": [
       "body"
