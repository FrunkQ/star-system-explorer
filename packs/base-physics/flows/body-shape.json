{
  "format": "sse.flow/1",
  "id": "sse.base.body-shape",
  "version": "0.1.0",
  "hook": "body.shape",
  "inputs": [
    {
      "name": "mass",
      "kind": "body.mass"
    },
    {
      "name": "radius",
      "kind": "body.radius"
    },
    {
      "name": "rotation_period",
      "kind": "body.rotation_period"
    },
    {
      "name": "inertia_factor",
      "kind": "model.moment_of_inertia_factor"
    }
  ],
  "nodes": [
    {
      "id": "spin",
      "atom": "sse.shape.spin_flattening"
    }
  ],
  "wires": [
    {
      "from": "in.mass",
      "to": "spin.mass"
    },
    {
      "from": "in.radius",
      "to": "spin.mean_radius"
    },
    {
      "from": "in.rotation_period",
      "to": "spin.rotation_period"
    },
    {
      "from": "in.inertia_factor",
      "to": "spin.inertia_factor"
    }
  ],
  "publishes": [
    {
      "kind": "shape.flattening",
      "from": "spin.flattening"
    },
    {
      "kind": "shape.equatorial_radius",
      "from": "spin.equatorial_radius"
    },
    {
      "kind": "shape.polar_radius",
      "from": "spin.polar_radius"
    }
  ],
  "tests": [
    {
      "name": "Jupiter (flattening 0.06487, NASA fact sheet; C 0.254)",
      "inputs": {
        "mass": {
          "value": 1.0,
          "unit": "m_jupiter"
        },
        "radius": {
          "value": 69911.0,
          "unit": "km"
        },
        "rotation_period": {
          "value": 0.41354,
          "unit": "day"
        },
        "inertia_factor": {
          "value": 0.254,
          "unit": "one"
        }
      },
      "expect": {
        "shape.flattening": {
          "value": 0.06487,
          "unit": "one",
          "tol": 0.005
        }
      }
    },
    {
      "name": "Saturn (flattening 0.09796, NASA fact sheet; C 0.210)",
      "inputs": {
        "mass": {
          "value": 5.6834e+26,
          "unit": "kg"
        },
        "radius": {
          "value": 58232.0,
          "unit": "km"
        },
        "rotation_period": {
          "value": 0.44401,
          "unit": "day"
        },
        "inertia_factor": {
          "value": 0.21,
          "unit": "one"
        }
      },
      "expect": {
        "shape.flattening": {
          "value": 0.09796,
          "unit": "one",
          "tol": 0.008
        }
      }
    },
    {
      "name": "Earth (flattening 0.003353; C 0.3307)",
      "inputs": {
        "mass": {
          "value": 1.0,
          "unit": "m_earth"
        },
        "radius": {
          "value": 6371.0,
          "unit": "km"
        },
        "rotation_period": {
          "value": 0.99727,
          "unit": "day"
        },
        "inertia_factor": {
          "value": 0.3307,
          "unit": "one"
        }
      },
      "expect": {
        "shape.flattening": {
          "value": 0.003353,
          "unit": "one",
          "tol": 0.0002
        }
      }
    }
  ]
}
