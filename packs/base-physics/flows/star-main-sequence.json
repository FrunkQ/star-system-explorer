{
  "format": "sse.flow/1",
  "id": "sse.base.star-main-sequence",
  "version": "0.1.0",
  "hook": "star.main_sequence",
  "inputs": [
    { "name": "mass", "kind": "star.mass" },
    { "name": "age", "kind": "star.age" }
  ],
  "nodes": [
    { "id": "lum", "atom": "sse.star.ms_luminosity" },
    { "id": "rad", "atom": "sse.star.ms_radius" },
    { "id": "teff", "atom": "sse.star.effective_temperature" },
    { "id": "life", "atom": "sse.star.ms_lifetime" },
    { "id": "now", "atom": "sse.star.ms_luminosity_at_age" }
  ],
  "wires": [
    { "from": "in.mass", "to": "lum.mass" },
    { "from": "in.mass", "to": "rad.mass" },
    { "from": "lum.luminosity", "to": "teff.luminosity" },
    { "from": "rad.radius", "to": "teff.radius" },
    { "from": "in.mass", "to": "life.mass" },
    { "from": "lum.luminosity", "to": "life.luminosity" },
    { "from": "lum.luminosity", "to": "now.typical" },
    { "from": "in.age", "to": "now.age" },
    { "from": "life.lifetime", "to": "now.lifetime" }
  ],
  "publishes": [
    { "kind": "star.luminosity", "from": "lum.luminosity" },
    { "kind": "star.radius", "from": "rad.radius" },
    { "kind": "star.effective_temperature", "from": "teff.teff" },
    { "kind": "star.main_sequence_lifetime", "from": "life.lifetime" },
    { "kind": "star.luminosity_at_age", "from": "now.luminosity" }
  ],
  "tests": [
    {
      "name": "Sun at 4.57 Gyr (IAU 2015 B3 nominal values; tolerances are the empirical relations' scatter)",
      "inputs": { "mass": { "value": 1.0, "unit": "m_sun" }, "age": { "value": 4.57, "unit": "gyr" } },
      "expect": {
        "star.luminosity": { "value": 1.0, "unit": "l_sun", "tol": 0.03 },
        "star.luminosity_at_age": { "value": 1.0, "unit": "l_sun", "tol": 0.03 },
        "star.radius": { "value": 1.0, "unit": "r_sun", "tol": 0.07 },
        "star.effective_temperature": { "value": 5772.0, "unit": "k", "tol": 200.0 },
        "star.main_sequence_lifetime": { "value": 10.0, "unit": "gyr", "tol": 0.3 }
      }
    },
    {
      "name": "Sirius A, 2.06 M☉, 0.24 Gyr (Liebert et al. 2005; Bond et al. 2017: L 25.4 L☉, R 1.71 R☉). The radius relation is for a typical-age star; young Sirius is 14 percent smaller, a known limit of the first wave",
      "inputs": { "mass": { "value": 2.063, "unit": "m_sun" }, "age": { "value": 0.24, "unit": "gyr" } },
      "expect": {
        "star.luminosity": { "value": 25.4, "unit": "l_sun", "tol": 5.0 },
        "star.radius": { "value": 1.711, "unit": "r_sun", "tol": 0.3 }
      }
    }
  ]
}
