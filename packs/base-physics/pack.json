      {
        "format": "sse.flow/1",
        "hook": "moon.tides",
        "id": "sse.base.moon-tides",
        "inputs": [
          {
            "kind": "orbit.host_mass",
            "name": "host_mass"
          },
          {
            "kind": "body.radius",
            "name": "radius"
          },
          {
            "kind": "orbit.semi_major_axis",
            "name": "semi_major_axis"
          },
          {
            "kind": "orbit.eccentricity",
            "name": "eccentricity"
          }
        ],
        "nodes": [
          {
            "atom": "sse.tides.eccentricity_heating",
            "id": "heat",
            "params": {
              "k2_over_q": 0.015
            }
          }
        ],
        "publishes": [
          {
            "from": "heat.power",
            "kind": "tides.heating_power"
          }
        ],
        "tests": [
          {
            "expect": {
              "tides.heating_power": {
                "tol": 19000000000000.0,
                "unit": "w",
                "value": 93000000000000.0
              }
            },
            "inputs": {
              "eccentricity": {
                "unit": "one",
                "value": 0.0041
              },
              "host_mass": {
                "unit": "m_jupiter",
                "value": 1.0
              },
              "radius": {
                "unit": "km",
                "value": 1821.6
              },
              "semi_major_axis": {
                "unit": "km",
                "value": 421700.0
              }
            },
            "name": "Io (Lainey et al. 2009: observed (0.93 ± 0.19) × 10¹⁴ W with k2/Q 0.015)"
          }
        ],
        "version": "0.1.0",
        "wires": [
          {
            "from": "in.host_mass",
            "to": "heat.host_mass"
          },
          {
            "from": "in.radius",
            "to": "heat.radius"
          },
          {
            "from": "in.semi_major_axis",
            "to": "heat.semi_major_axis"
          },
          {
            "from": "in.eccentricity",
            "to": "heat.eccentricity"
          }
        ]
      },
