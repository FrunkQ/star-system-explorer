   "rules": [
    {
     "id": "so.label.throne-world.v1",
     "tag": "so.label.throne-world",
     "applies_to": [
      "body"
     ],
     "when": {
      "if": "all",
      "of": [
       {
        "if": "all",
        "of": [
         {
          "if": "all",
          "of": [
           {
            "if": "not",
            "p": {
             "if": "has",
             "field": "star.effective_temperature"
            }
           },
           {
            "if": "not",
            "p": {
             "if": "has",
             "field": "mass_sun"
            }
           }
          ]
         },
         {
          "if": "any",
          "of": [
           {
            "if": "range",
            "field": "body.mass",
            "min": 2.9860839338956896e+23,
            "max": 5.972167867791379e+25
           },
           {
            "if": "range",
            "field": "mass_earth",
            "min": 0.05,
            "max": 10
           }
          ]
         }
        ]
       },
       {
        "if": "any",
        "of": [
         {
          "if": "range",
          "field": "surface_k",
          "min": 240,
          "max": 330
         },
         {
          "if": "all",
          "of": [
           {
            "if": "not",
            "p": {
             "if": "has",
             "field": "surface_k"
            }
           },
           {
            "if": "any",
            "of": [
             {
              "if": "range",
              "field": "orbit.semi_major_axis",
              "min": 119678296560.0,
              "max": 194477231910.0
             },
             {
              "if": "range",
              "field": "a_au",
              "min": 0.8,
              "max": 1.3
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "if": "not",
